names:
  - 7z{{file_ext_exe}}

match_version: 
  - string: '7-zip ([\d.]+)'
    group: 1
  - string: '7-zip \[32\] ([\d.]+)'
    group: 1

cmd_get_version: '{{exe_path}}'

uses:
- task: host,96ac7118439c4490
  global: True
- task: download-min-win-tools,2b5ee26b8d444ef6
  if: '"{{global.host.os.uname}}" == "windows"'
  global: True
