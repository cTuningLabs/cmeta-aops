# PyCharm
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

# Abstra
# Abstra is an AI-powered process automation framework.
# Ignore directories containing user credentials, local state, and settings.
# Learn more at https://abstra.io/docs
.abstra/

# Visual Studio Code
#  Visual Studio Code specific template is maintained in a separate VisualStudioCode.gitignore 
#  that can be found at https://github.com/github/gitignore/blob/main/Global/VisualStudioCode.gitignore
#  and can be added to the global gitignore or merged into this file. However, if you prefer, 
#  you could uncomment the following to ignore the entire vscode folder
# .vscode/

# Ruff stuff:
.ruff_cache/

# PyPI configuration file
.pypirc

# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# ---------------------------------------------------------------------------
# Un-ignore cMeta artifacts whose alias collides with a generic template rule
# above. `target/` (Rust build dir) and `venv/` (Python env) would otherwise
# shadow the real task artifacts `task/target/` and `task/venv/`, silently
# refusing any new file added inside them.
# ---------------------------------------------------------------------------
!task/target/
!task/target/**
!task/venv/
!task/venv/**

# ---------------------------------------------------------------------------
# cMeta AOps: generated run artifacts (kept locally, never published).
# These are produced by `cx <category> run` and capture the FULL environment of
# the machine that ran them — %PATH%, installed toolchains, absolute local
# paths and user names. Do not commit.
# ---------------------------------------------------------------------------
tmp/
tmp-*/
*tmp-cmeta-*
*cmeta-task-saved-*
*_repro_ctx_*
save-script-*.bat
save-script-*.sh

# Compiled build outputs left beside sources by program/task runs
*.class
*.obj
*.exe
*.o
*.a
*.lib

# Author's scratch/backup siblings (kept locally).
# Convention: a trailing digit (optionally + letters) on the extension marks a
# manual backup, e.g. _desc.yaml2, program.mojo6, api_v1.py.arc99b.
*.arc*
*.yaml[0-9]*
*.yml[0-9]*
*.json[0-9]*
*.py[0-9]*
*.mojo[0-9]*
*.rs[0-9]*
*.toml[0-9]*
*.js[0-9]*
*.ts[0-9]*
*.swift[0-9]*
*.java[0-9]*
*.go[0-9]*
*.c[0-9]*
*.h[0-9]*
*.cpp[0-9]*
*.bat[0-9]*
*.sh[0-9]*
*.md[0-9]*
*.txt[0-9]*
*.old
*.bak
*.orig
*.save
*-OLD
*-NEW

# Author's local Windows workflow scripts and AI-context symlinks
# (encode local paths and agent prompts).
/_run_claude*
/_run_tests.bat
/_create_symlinks*
/__symlinks/
/CLAUDE_local_sessions.md
.vscode/

# AI coding-session provenance - resume scripts and conversation summaries
# written into whatever directory the tool was launched from.
# Claude Code: the SessionStart / Stop / SessionEnd hooks in
# ~/.claude/hooks/provenance.py.
claude-resume-*.bat
claude-resume-*.sh
claude-summary-*.md
codex-resume-*.bat
codex-resume-*.sh
codex-summary-*.md

# Runtime state of a CMETA_HOME accidentally created inside this repo (cx run from here
# without CMETA_HOME set) and partial downloads left by task/download-file.
/index/
/repos/
/repos.json
*.partial

# The un-ignore rules for task/target/** and task/venv/** above also re-include their bytecode caches.
task/target/__pycache__/
task/venv/__pycache__/

# results written by test runs of a task (e.g. task/target--metal/result-metal.json)
task/*/result-*.json
