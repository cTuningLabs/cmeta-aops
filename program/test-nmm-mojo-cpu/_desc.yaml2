###################################################################################################
local_vars:
  src_file_name: 'program.py'

  output_files:
    - tmp-cmeta-program-stats.json

  result_files:
    stats: tmp-cmeta-program-stats.json

#  run_time_env:
#    KEY: value

#  params:
#    clean: True

compile:
  skip: True

run: 
  uses:
    # CPU: linux (profile)
    - task: setup,a2f9b61079ce4333
      name: perf,70caec51baf449aa
      if_os: linux
      if: '{{global.target.compute}} == ["cpu"] and "{{params.profile|False}}" == "True"'

    # CPU: windows (microsoft profile)
    - task: setup,a2f9b61079ce4333
      name: microsoft.windows.adk,45d476330b034ca1
      if_os: windows
      if: '{{global.target.compute}} == ["cpu"] and "{{params.profile|False}}" == "True"'

    - task: setup,a2f9b61079ce4333
      name: python

    - task: setup-run,148f6c1fdb4247df
      skip_clean_local: True
      chdir: '{{local.target_path}}'
      target_path: '{{local.target_path|$None}}'
      output_files: '{{local.output_files|$None}}'
      profile: '{{params.profile|$None}}'
      profile_python: '{{params.profile_python|$None}}'
      cmd: >-
        {{global.python.qpath}}
        {run_flags_after_exe}
        {{params.run_flags|}} 
        {{local.selected-program.path}}{{os_sep}}src{{os_sep}}{{local.src_file_name}}
      cmd_main: >-
        {{params.precision|float32}} 
        {{params.dim_m|300}} 
        {{params.dim_n|300}} 
        {{params.dim_k|300}}
        {{params.repeat|3}}
        {{params.clean|1}}
        {{params.seed|12345}}

    - task: cmd,c9ba0a88df394d7f
      storage_key: run-program
      save_script: '{{local.target_path}}/tmp-cmeta-run-program{{global.host.vars.file_ext_bat}}'
      chdir: '{{local.target_path}}'
      env: '{{local.run_time_env|$None}}'
      cmds: '{{local.run_time_cmds}}'

    - task: finish-run,5e14d7eca4f64440
      chdir: '{{local.target_path}}'
      target_path: '{{local.target_path|$None}}'
      result_files: '{{local.result_files|$None}}'
